content": ""}]}, {"correct": 1, "selected": 0, "id": 1, "_data": [{"type": "text", "content": "engenn6le11ob04re3aud11"}]}], "id": 6, "_data": [{"contents": [{"type": "text", "content": "So the next time you are reaching for the chocolate croissant or feeling cranky and craving a cookie, try the tips above."}], "type": "question"}, {"type": "objective", "content": "secondary_1"}]}, {"responses": [{"correct": 0, "selected": 0, "id": 0, "_data": [{"type": "text", "content": ""}]}, {"correct": 1, "selected": 0, "id": 1, "_data": [{"type": "text", "content": ""}]}], "id": 7, "_data": [{"contents": [{"type": "rec", "content": ""}], "type": "question"}, {"type": "objective", "content": "secondary_1"}]}], "type": "SR1", "id": 11, "_data": [{"contents": [{"type": "text", "content": "Let's practice using the cr sound."}], "type": "instructions"}, {"contents": [{"type": "group_name", "content": "Activity 1"}], "type": "group"}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "You are done!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}]}}, {"contents": [{"type": "skill", "content": "Listening"}, {"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Speaking"}], "type": "learning_skills"}, {"contents": [{"type": "text", "content": "Instructions: <span class=\"bullet\">\nListen to the audio. </span> <span class=\"bullet\">\nRecord yourself saying the sentences aloud.</span>\n <span class=\"bullet\">\nCompare yourself to the audio.</span>"}], "type": "post_instructions"}]}], "type": "scholar", "stimuli": [{"type": "welcome", "contents": [{}], "template_override": 1, "id": 0, "_data": []}, {"contents": [{"type": "slideshow", "value": {"coverimg": "engenn6le11ob04re2img01.jpg", "audiosrc": "engenn6le11ob04re2aud01", "images": [{"time": "0", "image": "engenn6le11ob04re2img01.jpg", "id": 0, "text": ""}, {"time": "100", "image": "engenn6le11ob04re2img01.jpg", "id": 1, "text": "Do you have any cravings? Sometimes I just have to have a cranberry crepe from my favorite breakfast cafe. Or a bag of crunchy potato chips when I'm watching a movie. What about you? If you want to stay healthy, you've got to control your cravings. Here are some tips for getting those pesky habits under control:"}, {"time": "20000", "image": "engenn6le11ob04re2img03.jpg", "id": 2, "text": "<ol><li>Create a distraction. Cravings usually last for a short time so you've got to focus your attention on something else. Call someone, listen to music or exercise to take your mind off the craving.</li>\n<li>Avoid triggers. Try to change what you eat in general. The first few days are the hardest to deal with, but it gets easier. </li>\n<li>Since stress is one of the biggest triggers for cravings, find another way to relax. Meditate, do yoga, or exercise. You have to find an outlet for your stress.</li></ol>"}, {"time": "55000", "image": "engenn6le11ob04re2img03.jpg", "id": 3, "text": "So the next time you are reaching for the chocolate croissant or feeling cranky and craving a cookie, try these tips above. You may surprise yourself!"}]}}], "template_override": 1, "title": "", "type": "audio", "id": 1, "_data": []}], "id": 0, "_data": [{"contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}], "type": "lab_options"}]}], "_data": [{"contents": [{"type": "lesson_name", "content": "Living Longer Better"}, {"type": "unit_name", "content": "Cream, Crust, Croutons"}, {"type": "position", "content": 4}, {"type": "origin", "content": "scholar > Grammar - part 3 > Yes  Agnes"}, {"type": "lesson", "content": 11}, {"type": "level", "content": "B1.1"}], "type": "metadata"}, {"contents": [{"type": "test", "content": "false"}], "type": "achievment_test"}, {"contents": [{"type": "primary", "content": "Identify and describe personal and regional eating habits and cooking in  a range of communicative situations."}, {"type": "secondary_1", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations"}, {"type": "secondary_2", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations"}, {"type": "secondary_3", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations"}, {"type": "secondary_4", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations"}, {"type": "secondary_5", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations"}, {"type": "secondary_6", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations"}, {"type": "secondary_7", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations"}, {"type": "secondary_8", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations"}], "type": "objectives"}, {"type": "background_image", "content": "engenn6le11ob04re1img01.jpg"}, {"contents": [{"type": "name", "content": "craving"}, {"type": "definition", "content": "a sudden and strong feeling for something  "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: <br/> <span class=\"strong\">Tom</span>: Do you have cravings? <br/> <span class=\"strong\">Joe</span>: Yes, for chocolate!"}, {"type": "audio", "content": "engenn6le11ob04aud01"}], "type": "target_word"}, {"contents": [{"type": "text", "content": "These are words you use to talk about cravings."}], "type": "target_word_describer"}, {"contents": [{"type": "heading", "content": "Expressing What Is Necessary"}, {"type": "describer", "content": "You can use the phrases <span class=\"italic\">have to</span> or <span class=\"italic\">have got to</span> to express what is necessary."}, {"type": "text", "content": "When you pronounce these phrases in conversation, you can link and reduce the sounds. "}, {"type": "text", "content": "For example: <span class=\"italic\">Have to</span> sounds like <span class=\"italic\">hafta</span>."}, {"type": "text", "content": "<span class=\"italic\">I hafta exercise. <br>She hasta eat chocolate.</span>"}, {"type": "text", "content": "<span class=\"italic\">Have got to</span> sounds like <span class=\"italic\">have gotta</span>."}, {"type": "text", "content": "He's gotta eat crunchy potato chips. <br>I've gotta do yoga."}, {"type": "text", "content": "Practice reading these examples aloud."}], "type": "learning_points"}, {"contents": [{"type": "heading", "content": "Linking and Deletion with Superlatives"}, {"type": "describer", "content": "You use a superlative adjective to express the highest degree of a quality. You use a superlative adjective to talk about one thing or person in a group of things. You always use <span class=\"italic\">the</span> with the superlative."}, {"type": "text", "content": "In natural conversation, it is common to link and delete some sounds in the superlative adjective if there is a similar sound in the next word. "}, {"type": "text", "content": "For example:"}, {"type": "text", "content": "The biggest sweet tooth.  <Br>You delete the \u2018t' sound and link the \u2018s' sound. <br>The bigges_sweet tooth."}, {"type": "text", "content": "Sometimes this makes it hard to listen to native speakers talk.<br> If you know the rule, you can listen better. "}, {"type": "text", "content": "Practice reading these words aloud:"}, {"type": "text", "content": "The smallest sweater  =  The smalles_sweater <br>The loudest truck = The loudes_truck"}], "type": "learning_points"}, {"contents": [{"type": "name", "content": "cranberry"}, {"type": "definition", "content": "a small, dark red fruit with a bitter taste "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I have a craving for cranberry muffins."}, {"type": "audio", "content": "engenn6le11ob04aud02"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "crepe"}, {"type": "definition", "content": "a round, flat, thin pancake "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I love crepes for breakfast."}, {"type": "audio", "content": "engenn6le11ob04aud03"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "croissant "}, {"type": "definition", "content": "a crescent-shaped pastry; a popular French breakfast food "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I love chocolate croissants!"}, {"type": "audio", "content": "engenn6le11ob04aud04"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "cranky"}, {"type": "definition", "content": "easily upset; in a bad mood "}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: I get cranky when I have a craving."}, {"type": "audio", "content": "engenn6le11ob04aud05"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "trigger"}, {"type": "definition", "content": "something that causes something else to happen "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Stress is a trigger for cravings."}, {"type": "audio", "content": "engenn6le11ob04aud06"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "distraction"}, {"type": "definition", "content": "something that takes your attention away from something else "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Find a distraction to avoid giving in to cravings."}, {"type": "audio", "content": "engenn6le11ob04aud07"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "to meditate"}, {"type": "definition", "content": "to mentally relax by thinking about one thing "}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: A good distraction is to meditate."}, {"type": "audio", "content": "engenn6le11ob04aud08"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "outlet "}, {"type": "definition", "content": "a release "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Exercise is a good outlet for stress."}, {"type": "audio", "content": "engenn6le11ob04aud09"}], "type": "target_word"}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Write down 3 things you have a craving for."}, {"type": "text", "content": "Write down 3 ways you deal with the cravings."}, {"type": "text", "content": "Discuss your points with your partner. Did you learn any other ways to deal with triggers?"}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I write down my cravings and how I deal with them."}, {"type": "text", "content": "My partner and I exchange information on how to deal with cravings."}]}]}