rect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"contents": [{"type": "text", "content": "Instructions: <span class=\"bullet\">Listen to the audio.</span> <span class=\"bullet\">Click on TRUE if the statement is true.</span> <span class=\"bullet\">Click on FALSE if the statement is false. </span>\n"}], "type": "post_instructions"}]}, {"stimuli_ids": [], "template_override": 1, "questions": [{"responses": [{"correct": 0, "id": 0, "selected": 0, "_data": [{"type": "text", "content": ""}]}, {"correct": 1, "id": 1, "selected": 0, "_data": [{"type": "text", "content": ""}]}], "id": 0, "_data": [{"contents": [{"type": "text", "content": ""}], "type": "question"}]}], "type": "RSLT", "id": 11, "_data": [{"contents": [], "type": "instructions"}, {"contents": [{"type": "group_name", "content": "Quiz"}], "type": "group"}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}]}], "type": "scholar", "stimuli": [{"type": "welcome", "contents": [{}], "template_override": 1, "id": 0, "_data": []}, {"contents": [{"type": "slideshow", "value": {"coverimg": "engenn6le11ob01re2img01.jpg", "audiosrc": "engenn6le11ob01re2aud01", "images": [{"time": "0", "image": "engenn6le11ob01re2img01.jpg", "id": 0, "text": ""}, {"time": "100", "image": "engenn6le11ob01re2img01.jpg", "id": 1, "text": "In 1997, the world's oldest person died in Arles, France. Jeanne Calment was 122 years old.\nUntil she was 100, Jeanne rode her bicycle through the streets of Arles. She took energetic walks, and ate more than two pounds of chocolate a week. She did not quit smoking until the age of 117."}, {"time": "24500", "image": "engenn6le11ob01re2img01.jpg", "id": 2, "text": "When Ms. Calment was 120, I asked her for any advice she could give me toward living a long active life. She said I should eat well. She stated that I ought to drink wine to help me relax. She thought I should eat dark chocolate too! Oh, and I had better not smoke, because the air is no longer clean."}, {"time": "45000", "image": "engenn6le11ob01re2img01.jpg", "id": 3, "text": "Jeanne said I had better bicycle. Exercise keeps your body strong. When I said I would prefer to walk, she laughed. You need to laugh too, she added. It releases stress. Of course, you had better find someone to love. Love makes life better. Companionship is essential!"}]}}], "template_override": 1, "title": "", "type": "audio", "id": 1, "_data": []}], "id": 0, "_data": [{"contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}], "type": "lab_options"}]}], "_data": [{"contents": [{"type": "lesson_name", "content": "Living Longer Better"}, {"type": "unit_name", "content": "How Old Is Old?"}, {"type": "position", "content": 1}, {"type": "origin", "content": "scholar > Grammar - part 3 > Yes  Agnes"}, {"type": "lesson", "content": 11}, {"type": "level", "content": "B1.1"}], "type": "metadata"}, {"contents": [{"type": "test", "content": "false"}], "type": "achievment_test"}, {"contents": [{"type": "primary", "content": "Describe  routines and regular activities in a wider range of social and work contexts."}, {"type": "secondary_1", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations"}, {"type": "secondary_2", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations"}, {"type": "secondary_3", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations"}, {"type": "secondary_4", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations"}, {"type": "secondary_5", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations"}, {"type": "secondary_6", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations"}, {"type": "secondary_7", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations"}, {"type": "secondary_8", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations"}], "type": "objectives"}, {"type": "background_image", "content": "engenn6le11ob01re1img01.jpg"}, {"contents": [{"type": "heading", "content": "Healthy Habits "}, {"type": "describer", "content": "Developing healthy habits and avoiding unhealthy ones can help you live longer."}, {"type": "text", "content": "Healthy habits include: <ul><li>Eating fruits and vegetables </li><li>Exercising</li><li>Oral hygiene or brushing your teeth </li><li>Getting medical check-ups </li><li> Not smoking </li><li>Getting enough sleep</li> "}, {"type": "text", "content": "These healthy habits are generally recommended by physicians who tell you what is advisable using: <span class=\"italic\">ought to</span>, <span class=\"italic\">had better</span>, <span class=\"italic\">should</span> and <span class=\"italic\">need to</span>."}, {"type": "example", "content": "You had better quit smoking."}, {"type": "example", "content": "You ought to get regular medical checkups."}], "type": "learning_points"}, {"contents": [{"type": "heading", "content": "Offering Health Advice and Solutions"}, {"type": "describer", "content": "<p>You can offer advice and solutions to people on how to improve their health or longevity.</p>Remember to offer advice politely and to use the modals <span class=\"italic\">could, should</span> or <span class=\"italic\">might</span> to propose a solution: <br>  <ul><li><span class=\"italic\">You should ...</span></li><li><span class=\"italic\">You need to ...</span></li><li><span class=\"italic\">You ought to ...</span> (strong request) </li><li><span class=\"italic\">You had better ...</span>(strong request)</li></ul>"}, {"type": "table", "content": "{\"rows\":5,\"columns\":1,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Offering Advice and Solutions\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">She said I should eat well.</span> \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">She stated that I ought to drink wine to help me relax.</span> \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I'd better cycle, because it is an alternative to be healthy.</span> \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">You need to laugh too, she added. It releases stress. </span> \\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}"}], "type": "learning_points"}, {"contents": [{"type": "name", "content": "to die"}, {"type": "definition", "content": "to stop living"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: She died in 1997."}, {"type": "audio", "content": "engenn6le11ob01aud01"}], "type": "target_word"}, {"contents": [{"type": "text", "content": "These are words you use to talk about an older person."}], "type": "target_word_describer"}, {"contents": [{"type": "name", "content": "to state"}, {"type": "definition", "content": "to say "}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: She stated that I ought to drink wine. "}, {"type": "audio", "content": "engenn6le11ob01aud02"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "to release"}, {"type": "definition", "content": "to let go of "}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: You have to relax to release stress."}, {"type": "audio", "content": "engenn6le11ob01aud03"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "to quit"}, {"type": "definition", "content": "to stop going "}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: She quit smoking last year. "}, {"type": "audio", "content": "engenn6le11ob01aud04"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "advice"}, {"type": "definition", "content": "an opinion on what someone should do"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: What advice can you give me on living a long life? "}, {"type": "audio", "content": "engenn6le11ob01aud05"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "active"}, {"type": "definition", "content": "busy"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: She led a very active life. "}, {"type": "audio", "content": "engenn6le11ob01aud06"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "companionship"}, {"type": "definition", "content": "spending time with other people  "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Companionship is essential to living well!"}, {"type": "audio", "content": "engenn6le11ob01aud07"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "essential "}, {"type": "definition", "content": "necessary or needed "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: A good diet is essential to staying healthy."}, {"type": "audio", "content": "engenn6le11ob01aud08"}], "type": "target_word"}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Go online and look for stories on people who lived a long time."}, {"type": "text", "content": "Find out what age they lived to."}, {"type": "text", "content": "Find out where they lived."}, {"type": "text", "content": "Find out about their habits and routines."}, {"type": "text", "content": "Write down any advice they gave to live a long life."}, {"type": "text", "content": "Put all the information in a 75-90 word paragraph."}, {"type": "text", "content": "Read your paragraph to a partner."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I research a person who lived a long time."}, {"type": "text", "content": "I mention their age and where they lived."}, {"type": "text", "content": "I write about their habits and routines."}, {"type": "text", "content": "I write any advice they gave to live a long life."}, {"type": "text", "content": "I read the paragraph to my partner."}]}]}